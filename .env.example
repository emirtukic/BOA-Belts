PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
# Koristi se samo pri prvom pokretanju; kasnije se lozinka mijenja u adminu (Promjena lozinke).
ADMIN_PASSWORD=change-this-password

# Kontakt forma i svi e-mailovi webshopa (Gmail + app password, samo na serveru)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=boabelts.webshop@gmail.com

# Glavna adresa sajta. Lokalno ostaje localhost, a u produkciji:
# APP_URL=https://www.boabelts.com
APP_URL=http://localhost:3000

# Samo u produkciji
# NODE_ENV=production
# DATA_DIR=/var/lib/boabelts   (baza i uploadi, prezivljavaju novi deploy)
# SITE_NOINDEX=true            (samo za testno okruzenje - sakriva sajt od Google-a)

# Samo lokalno: mailovi se upisuju kao HTML u ovaj folder umjesto slanja.
# MAIL_PREVIEW_DIR=./mailovi

# Prijava preko Google-a. Redirect URI u produkciji:
# https://www.boabelts.com/nalog/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
