<%- include('../../partials/admin-head') %>
<%- include('../../partials/admin-sidebar') %>

<div class="admin-header">
  <h1>Promo kod: <%= promoCode.code %></h1>
  <a href="/admin/promo-kodovi/<%= promoCode.id %>/izmijeni" class="btn btn-outline">Izmijeni</a>
</div>

<div class="admin-form-grid">
  <div class="form-panel">
    <h3 style="margin-top:0;">Detalji</h3>
    <p><strong>Popust:</strong> <%= promoCode.type === 'percent' ? promoCode.value + '%' : promoCode.value.toFixed(2) + ' KM' %></p>
    <p><strong>Za koga:</strong> <%= audienceLabels[promoCode.audience] %><%= promoCode.audience === 'novi_korisnici' ? ' (nalog mlađi od ' + (promoCode.new_customer_days || 30) + ' dana)' : '' %></p>
    <p><strong>Status:</strong> <%= promoCode.active ? 'Aktivan' : 'Neaktivan' %></p>
    <p><strong>Iskorišteno:</strong> <%= promoCode.used_count %><%= promoCode.usage_limit ? ' / ' + promoCode.usage_limit : ' (bez ograničenja)' %></p>
    <p><strong>Ističe:</strong> <%= promoCode.expires_at ? promoCode.expires_at : 'nikad' %></p>
  </div>

  <div class="form-panel full">
    <h3 style="margin-top:0;">Narudžbe koje su koristile ovaj kod (<%= orders.length %>)</h3>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Kupac</th>
            <th>Popust</th>
            <th>Ukupno</th>
            <th>Datum</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (orders.length === 0) { %>
            <tr><td colspan="6">Ovaj kod još nije iskorišten ni u jednoj narudžbi.</td></tr>
          <% } %>
          <% orders.forEach(function(order) { %>
            <tr>
              <td>#<%= order.id %></td>
              <td><%= order.customer_name %></td>
              <td>-<%= order.discount_km.toFixed(2) %> KM</td>
              <td><%= order.total_km.toFixed(2) %> KM</td>
              <td><%= formatDate(order.created_at) %></td>
              <td><a href="/admin/narudzbe/<%= order.id %>" class="btn btn-outline btn-small">Otvori</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<a href="/admin/promo-kodovi" class="btn btn-outline mt-lg">&larr; Svi promo kodovi</a>

<%- include('../../partials/admin-footer') %>
