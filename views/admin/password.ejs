<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-header">
  <h1>Promjena lozinke</h1>
</div>

<form class="form-panel" style="max-width: 480px;" action="/admin/lozinka" method="POST">
  <div class="form-row">
    <label for="current_password">Trenutna lozinka</label>
    <input type="password" id="current_password" name="current_password" autocomplete="current-password" required>
  </div>
  <div class="form-row">
    <label for="new_password">Nova lozinka</label>
    <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="10" required>
    <small>Najmanje 10 karaktera.</small>
  </div>
  <div class="form-row">
    <label for="new_password2">Ponovi novu lozinku</label>
    <input type="password" id="new_password2" name="new_password2" autocomplete="new-password" minlength="10" required>
  </div>
  <button type="submit" class="btn btn-primary">Sačuvaj lozinku</button>
</form>

<%- include('../partials/admin-footer') %>
