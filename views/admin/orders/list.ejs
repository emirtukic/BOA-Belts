<%- include('../../partials/admin-head') %>
<%- include('../../partials/admin-sidebar') %>

<div class="admin-header">
  <h1>Narudžbe</h1>
</div>

<form class="orders-export" action="/admin/narudzbe/izvoz" method="GET">
  <strong>Izvoz u Excel</strong>
  <label>Od <input type="date" name="od" value="<%= exportFrom %>" required></label>
  <label>Do <input type="date" name="do" value="<%= exportTo %>" required></label>
  <button type="submit" class="btn btn-outline btn-small">Preuzmi .xlsx</button>
  <small>Sve narudžbe u periodu, i otkazane (sa statusom), plus list sa svim stavkama.</small>
</form>

<div class="category-filters" style="justify-content:flex-start;">
  <a href="/admin/narudzbe" class="<%= !activeStatus ? 'active' : '' %>">Sve</a>
  <% statuses.forEach(function(s) { %>
    <a href="/admin/narudzbe?status=<%= s.id %>" class="<%= activeStatus === s.id ? 'active' : '' %>"><%= s.label %></a>
  <% }) %>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Kupac</th>
        <th>Telefon</th>
        <th>Grad</th>
        <th>Ukupno</th>
        <th>Status</th>
        <th>Datum</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="8">Nema narudžbi.</td></tr>
      <% } %>
      <% orders.forEach(function(order) { %>
        <tr>
          <td>#<%= order.id %></td>
          <td><%= order.customer_name %></td>
          <td><%= order.phone %></td>
          <td><%= order.city %></td>
          <td><%= order.total_km.toFixed(2) %> KM</td>
          <td><span class="status-tag status-<%= order.status %>"><%= statusLabels[order.status] || order.status %></span></td>
          <td><%= formatDate(order.created_at) %></td>
          <td><a href="/admin/narudzbe/<%= order.id %>" class="btn btn-outline btn-small">Otvori</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/admin-footer') %>
