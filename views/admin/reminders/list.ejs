<%- include('../../partials/admin-head') %>
<%- include('../../partials/admin-sidebar') %>

<div class="admin-header">
  <h1>Podsjetnici</h1>
</div>

<div class="admin-panel-box" style="margin-bottom:24px; max-width:600px;">
  <h3>Novi podsjetnik</h3>
  <form action="/admin/podsjetnici" method="POST" class="todo-add-form">
    <div class="form-row" style="flex:1; min-width:220px;">
      <label for="text">Tekst</label>
      <input type="text" id="text" name="text" required placeholder="npr. Naruči nove kutije za pakovanje">
    </div>
    <div class="form-row">
      <label for="due_date">Rok (opciono)</label>
      <input type="date" id="due_date" name="due_date">
    </div>
    <button type="submit" class="btn btn-primary">Dodaj</button>
  </form>
</div>

<div class="admin-panel-box" style="max-width:600px;">
  <% if (reminders.length === 0) { %>
    <p>Nema podsjetnika još.</p>
  <% } else { %>
    <div class="todo-list">
      <% reminders.forEach(function(r) { %>
        <div class="todo-item <%= r.done ? 'is-done' : '' %>">
          <form action="/admin/podsjetnici/<%= r.id %>/toggle?_method=PUT" method="POST">
            <label class="todo-checkbox">
              <input type="checkbox" <%= r.done ? 'checked' : '' %> onchange="this.form.submit()">
              <span></span>
            </label>
          </form>
          <div class="todo-text">
            <%= r.text %>
            <% if (r.due_date) { %><span class="todo-due">Rok: <%= r.due_date %></span><% } %>
          </div>
          <form action="/admin/podsjetnici/<%= r.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Obrisati podsjetnik?');">
            <button type="submit" class="todo-delete" aria-label="Obriši">&times;</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../../partials/admin-footer') %>
