<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="eyebrow">Korpa</div>
      <h1>Vaša korpa</h1>
      <hr class="divider">
    </div>


    <% if (items.length === 0) { %>
      <div class="empty-state">
        <h3>Vaša korpa je prazna.</h3>
        <a href="/kolekcija" class="btn btn-primary mt-lg">Pogledajte kolekciju</a>
      </div>
    <% } else { %>
      <%# Na kompjuteru red sa kolonama, na mobitelu kartica po proizvodu. %>
      <div class="cart-list">
        <div class="cart-list-head" aria-hidden="true">
          <span>Proizvod</span>
          <span>Količina</span>
          <span>Cijena</span>
          <span></span>
        </div>
        <% items.forEach(function(item) { %>
          <div class="cart-row">
            <a href="/kolekcija/<%= item.product.slug %>" class="cart-row-image">
              <img src="<%= item.product.smallImage(item.product.imageFor(item.color)) %>" alt="<%= item.product.name %>">
            </a>
            <div class="cart-row-info">
              <a href="/kolekcija/<%= item.product.slug %>" class="cart-row-name"><%= item.product.name %></a>
              <% if (item.product.onSale) { %>
                <div class="cart-row-sale"><span class="price-old"><%= item.product.price_km.toFixed(2) %> KM</span><span class="price-now"><%= item.product.sale_price_km.toFixed(2) %> KM</span></div>
              <% } %>
              <ul class="cart-row-options">
                <% itemOptions(item).forEach(function(option) { %><li><%= option %></li><% }) %>
              </ul>
            </div>
            <form action="/korpa/<%= item.index %>?_method=PUT" method="POST" class="cart-row-qty">
              <input type="number" name="qty" value="<%= item.qty %>" min="1"<% if (item.maxQty !== null) { %> max="<%= item.maxQty %>"<% } %> class="qty-input" aria-label="Količina">
              <button type="submit" class="btn btn-outline btn-small">Ažurirajte</button>
            </form>
            <div class="cart-row-price"><%= item.lineTotal.toFixed(2) %> KM</div>
            <form action="/korpa/<%= item.index %>?_method=DELETE" method="POST" class="cart-row-remove">
              <button type="submit" class="btn btn-danger btn-small" aria-label="Uklonite <%= item.product.name %> iz korpe">Uklonite</button>
            </form>
          </div>
        <% }) %>
        <div class="cart-list-total">
          <span>Ukupno</span>
          <strong><%= total.toFixed(2) %> KM</strong>
        </div>
      </div>
      <p class="text-center" style="color:#6a6a6a; font-size:0.85rem;">Poštarina se dodaje u sljedećem koraku.</p>

      <div class="text-center">
        <a href="/narudzba" class="btn btn-primary">Završite narudžbu</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
