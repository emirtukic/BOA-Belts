<section class="newsletter-signup">
  <div class="container text-center">
    <% const nlTexts = newsletterTexts || { heading: 'Prijavite se na newsletter', text: '' }; %>
    <% if (nlTexts.heading) { %><h2><%= nlTexts.heading %></h2><% } %>
    <% if (nlTexts.text) { %><p><%= nlTexts.text %></p><% } %>
    <form action="/newsletter/prijava" method="POST" class="newsletter-form" id="newsletterForm" novalidate>
      <div class="newsletter-form-row">
        <input type="email" name="email" id="newsletterEmail" placeholder="E-mail">
        <button type="submit" class="btn btn-primary">Pretplatite se</button>
      </div>
      <label class="checkbox-row newsletter-consent" id="newsletterConsentRow">
        <input type="checkbox" name="privacy" id="newsletterPrivacy">
        Prihvatam <a href="/politika-privatnosti" target="_blank">politiku privatnosti</a>
      </label>
    </form>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Boa Belts - početna">
          <img src="/images/logo/boa-logo.svg" alt="Boa Belts" width="90" height="40" loading="lazy">
          <span>Boa Belts</span>
        </a>
        <p>Prvi bosanskohercegovački brend ručno rađenih kožnih kaiševa, koji odnedavno širi asortiman i na druge modne dodatke. Svaki komad nastaje u našoj radionici u Travniku.</p>
        <div class="social-links">
          <a href="https://www.instagram.com/boa_belts/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100027303537151" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 8.5h2V5.2c-.35-.05-1.54-.15-2.94-.15-2.9 0-4.9 1.77-4.9 5.02v2.68H6.3v3.7h2.86V21h3.7v-8.55h2.75l.44-3.7h-3.19V10.5c0-1.07.29-1.8 1.94-1.8z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Kolekcija</h4>
        <% (typeof navCategories !== 'undefined' ? navCategories : []).forEach(function(cat) { %>
          <p><a href="/kolekcija?kategorija=<%= cat.slug %>"><%= cat.name %></a></p>
        <% }) %>
        <p><a href="/kolekcija">Svi proizvodi</a></p>
      </div>

      <div class="footer-col">
        <h4>Boa Belts</h4>
        <p><a href="/o-nama">O nama</a></p>
        <p><a href="/program-lojalnosti">Program lojalnosti</a></p>
        <p><a href="/bh-fashion-week">BH Fashion Week</a></p>
        <p><a href="/kontakt">Kontakt</a></p>
      </div>

      <div class="footer-col">
        <h4>Kontakt</h4>
        <p>Travnik, Bosna i Hercegovina</p>
        <p><a href="mailto:boabelts.webshop@gmail.com">boabelts.webshop@gmail.com</a></p>
        <p><a href="tel:+387603265484">+387 60 32 65 484</a></p>
      </div>
    </div>

    <div class="footer-legal-links">
      <a href="/uslovi-koristenja">Uslovi korištenja</a>
      <a href="/politika-privatnosti">Politika privatnosti</a>
    </div>

    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> Boa Belts. Sva prava zadržana.</span>
      <span class="footer-credit">Developed by ET</span>
    </div>
  </div>
</footer>

<% if (typeof sitePopup !== 'undefined' && sitePopup && (sitePopup.heading || sitePopup.text || sitePopup.image)) { %>
  <div class="site-popup-overlay" id="sitePopupOverlay" data-delay="<%= sitePopup.delay_seconds %>" data-auto-close="<%= sitePopup.auto_close_seconds %>">
    <div class="site-popup">
      <button type="button" class="site-popup-close" id="sitePopupClose" aria-label="Zatvori">&times;</button>
      <% if (sitePopup.image) { %>
        <div class="site-popup-image">
          <img src="<%= sitePopup.image %>" alt="">
        </div>
      <% } %>
      <div class="site-popup-body">
        <% if (sitePopup.heading) { %><h3><%= sitePopup.heading %></h3><% } %>
        <% if (sitePopup.text) { %><p><%= sitePopup.text %></p><% } %>
        <% if (sitePopup.cta_text) { %>
          <a href="<%= sitePopup.cta_link || '/kolekcija' %>" class="btn btn-primary"><%= sitePopup.cta_text %></a>
        <% } %>
      </div>
    </div>
  </div>
<% } %>

<div class="toast-notification" id="toastNotification" role="status" aria-live="polite">
  <span id="toastMessage"></span>
</div>

<div class="lightbox-overlay" id="lightboxOverlay">
  <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Zatvori">&times;</button>
  <button type="button" class="lightbox-nav prev" id="lightboxPrev" aria-label="Prethodna slika">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <img src="" alt="" class="lightbox-image" id="lightboxImage">
  <button type="button" class="lightbox-nav next" id="lightboxNext" aria-label="Sljedeća slika">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
  </button>
</div>

<div class="cart-drawer-overlay" id="cartDrawerOverlay"></div>
<aside class="cart-drawer" id="cartDrawer" aria-hidden="true">
  <div class="cart-drawer-header">
    <h3>Vaša korpa</h3>
    <button type="button" class="cart-drawer-close" id="cartDrawerClose" aria-label="Zatvori">&times;</button>
  </div>
  <div class="cart-drawer-body" id="cartDrawerBody">
    <div class="drawer-loading">Učitavanje...</div>
  </div>
</aside>

<div class="chat-float" id="chatFloat">
  <div class="chat-float-menu" id="chatMenu" hidden>
    <p>Pišite nam, odgovaramo brzo.</p>
    <a href="<%= chat.whatsapp %>?text=<%= encodeURIComponent('Zdravo, imam pitanje u vezi Boa Belts proizvoda.') %>" target="_blank" rel="noopener" class="chat-option chat-whatsapp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2zm0 17.7a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.9 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.3-.2z"/></svg>
      WhatsApp
    </a>
    <a href="<%= chat.viber %>" class="chat-option chat-viber">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.4 2C7.6 2 3.4 3 3 9c-.2 3.1.3 5.4 1.9 7v3.6c0 .5.6.8 1 .4l2.6-2.6c1 .2 2 .3 2.9.3 3.8 0 8-1 8.4-7 .4-6.6-3.6-8.7-8.4-8.7zm4.7 12.1c-.4.6-1 1.2-1.7 1.1-1.3-.2-3-1.2-4.3-2.5S7.9 9.8 7.7 8.5c-.1-.7.5-1.3 1.1-1.7.3-.2.7-.1.9.2l1 1.4c.2.3.1.7-.1.9l-.4.4c.4 1.1 1.4 2.1 2.5 2.5l.4-.4c.2-.3.6-.3.9-.1l1.4 1c.3.2.4.6.2.9zM12.5 6c2 .1 3.6 1.7 3.7 3.7h-.9c-.1-1.5-1.3-2.7-2.8-2.8V6zm0 1.7c1.1.1 1.9.9 2 2h-.9c0-.6-.5-1-1.1-1.1v-.9z"/></svg>
      Viber
    </a>
  </div>
  <button type="button" class="chat-float-btn" id="chatToggle" aria-expanded="false" aria-controls="chatMenu" aria-label="Pišite nam na Viber ili WhatsApp">
    <svg class="chat-icon-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.4 3.6c-.4.3-.9 0-.9-.4V16A2.5 2.5 0 0 1 4 13.5z"/></svg>
    <svg class="chat-icon-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>

<script src="/js/main.js?v=5"></script>
</body>
</html>
