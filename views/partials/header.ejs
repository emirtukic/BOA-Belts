<%
  const activeCat = currentPath === '/kolekcija' && typeof activeCategory !== 'undefined' ? activeCategory : null;
  const navLinks = [
    { href: '/', label: 'Početna', active: currentPath === '/' },
    { href: '/kolekcija?kategorija=zenski-kaisevi', label: 'Kaiševi', active: activeCat === 'zenski-kaisevi' || activeCat === 'muski-kaisevi' },
    { href: '/kolekcija?kategorija=torbe', label: 'Torbe', active: activeCat === 'torbe' },
    { href: '/kolekcija?kategorija=novcanici', label: 'Novčanici', active: activeCat === 'novcanici' },
    { href: '/kolekcija?kategorija=dodaci', label: 'Dodaci', active: activeCat === 'dodaci' },
    { href: '/o-nama', label: 'O nama', active: currentPath === '/o-nama' },
    { href: '/kontakt', label: 'Kontakt', active: currentPath === '/kontakt' }
  ];
%>
<div class="announcement-bar">
  <div class="announcement-track">
    <span>Dostava širom BiH 3-4 radna dana</span><span>Plaćanje pouzećem</span><span>Kaiševi po vašoj mjeri</span>
    <span class="announcement-copy" aria-hidden="true">Dostava širom BiH 3-4 radna dana</span><span class="announcement-copy" aria-hidden="true">Plaćanje pouzećem</span><span class="announcement-copy" aria-hidden="true">Kaiševi po vašoj mjeri</span>
  </div>
</div>
<header class="site-header" id="siteHeader">
  <div class="container">
    <a href="/" class="logo" aria-label="Boa Belts - početna">
      <img src="/images/logo/boa-logo.svg" alt="Boa Belts" width="90" height="40">
      <span class="logo-text">Boa Belts</span>
    </a>
    <nav class="main-nav" id="mainNav" aria-label="Glavni meni">
      <% navLinks.forEach(function(link) { %>
        <a href="<%= link.href %>" class="<%= link.active ? 'active' : '' %>"><%= link.label %></a>
      <% }) %>
    </nav>
    <div class="header-actions">
      <button type="button" class="search-toggle" id="searchToggle" aria-label="Pretraga">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <a href="/lista-zelja" class="account-link wish-link" aria-label="Lista želja">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5s-7.8-4.7-9.3-9.6C1.6 7.4 3.9 4.2 7.3 4.2c2 0 3.6 1.1 4.7 2.8 1.1-1.7 2.7-2.8 4.7-2.8 3.4 0 5.7 3.2 4.6 6.7-1.5 4.9-9.3 9.6-9.3 9.6z"/></svg>
        <span class="wish-badge" id="wishBadge" hidden></span>
      </a>
      <a href="<%= isCustomerLoggedIn ? '/nalog' : '/nalog/prijava' %>" class="account-link account-link-user" aria-label="Moj nalog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="3.6"/>
          <path d="M4.5 20c1.4-3.6 4.3-5.5 7.5-5.5s6.1 1.9 7.5 5.5"/>
        </svg>
      </a>
      <a href="/korpa" class="cart-link" id="cartToggle" aria-label="Korpa" aria-haspopup="true" aria-controls="cartDrawer">
        <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 7h15l-1.6 9.5a1.5 1.5 0 0 1-1.48 1.25H8.4a1.5 1.5 0 0 1-1.48-1.25L5.2 4.5H2"/>
          <circle cx="9.5" cy="21" r="1.15"/>
          <circle cx="18" cy="21" r="1.15"/>
        </svg>
        <span id="cartBadgeWrap"><% if (cartCount > 0) { %><span class="cart-badge" id="cartBadge"><%= cartCount %></span><% } %></span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Meni">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="search-panel" id="searchPanel">
    <div class="container search-panel-inner">
      <form action="/kolekcija" method="GET" class="search-panel-form" id="searchForm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" name="pretraga" id="searchInput" placeholder="Pretražite kaiševe, torbe, novčanike..." aria-label="Pretražite proizvode" autocomplete="off">
        <button type="button" class="search-panel-close" id="searchClose" aria-label="Zatvori pretragu">&times;</button>
      </form>
      <div class="search-panel-results" id="searchResults"></div>
    </div>
  </div>
</header>

<!--
  Mobilna off-canvas ladica je NAMJERNO potpuno odvojen element od desktop
  .main-nav (ne dijeli isti DOM cvor) - .site-header ima backdrop-filter, a
  backdrop-filter na pretku stvara novi "containing block" za position:fixed
  djecu, sto zna izazvati nekonzistentno ponasanje (narocito u browser
  dev-tools device-toolbar zoom/fit rezimu) ako bi ladica bila ugnijezdena
  unutar headera. Ovako je ladica direktno dijete <body> (isti nivo kao i
  cart-drawer, koji radi ispravno), pa nema dvosmislenosti oko pozicije.
-->
<div class="nav-overlay" id="navOverlay"></div>
<nav class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <button type="button" class="mobile-nav-close" id="mobileNavClose" aria-label="Zatvori meni">&times;</button>
  <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Početna</a>
  <a href="/kolekcija" class="<%= currentPath === '/kolekcija' && !activeCat ? 'active' : '' %>">Cijela kolekcija</a>
  <% (typeof navCategories !== 'undefined' ? navCategories : []).forEach(function(cat) { %>
    <a href="/kolekcija?kategorija=<%= cat.slug %>" class="mobile-nav-sub<%= activeCat === cat.slug ? ' active' : '' %>"><%= cat.name %></a>
  <% }) %>
  <a href="/o-nama" class="<%= currentPath === '/o-nama' ? 'active' : '' %>">O nama</a>
  <a href="/kontakt" class="<%= currentPath === '/kontakt' ? 'active' : '' %>">Kontakt</a>
  <a href="/lista-zelja" class="<%= currentPath === '/lista-zelja' ? 'active' : '' %>">Lista želja</a>
  <a href="/program-lojalnosti" class="<%= currentPath === '/program-lojalnosti' ? 'active' : '' %>">Program lojalnosti</a>
  <a href="/bh-fashion-week" class="<%= currentPath === '/bh-fashion-week' ? 'active' : '' %>">BH Fashion Week</a>
  <div class="mobile-nav-divider"></div>
  <a href="<%= isCustomerLoggedIn ? '/nalog' : '/nalog/prijava' %>" class="mobile-nav-account">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8" r="3.6"/>
      <path d="M4.5 20c1.4-3.6 4.3-5.5 7.5-5.5s6.1 1.9 7.5 5.5"/>
    </svg>
    <%= isCustomerLoggedIn ? 'Moj nalog' : 'Prijava / Registracija' %>
  </a>
  <div class="mobile-nav-social">
    <a href="https://www.instagram.com/boa_belts/" target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href="https://www.facebook.com/profile.php?id=100027303537151" target="_blank" rel="noopener" aria-label="Facebook">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 8.5h2V5.2c-.35-.05-1.54-.15-2.94-.15-2.9 0-4.9 1.77-4.9 5.02v2.68H6.3v3.7h2.86V21h3.7v-8.55h2.75l.44-3.7h-3.19V10.5c0-1.07.29-1.8 1.94-1.8z"/></svg>
    </a>
  </div>
</nav>

<% if ((typeof flashSuccess !== 'undefined' && flashSuccess.length) || (typeof flashError !== 'undefined' && flashError.length)) { %>
  <div class="container" style="padding-top:20px;">
    <%- include('flash') %>
  </div>
<% } %>
