<!DOCTYPE html>
<html lang="bs">
<head>
  <meta charset="UTF-8">
  <script>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%
    const metaDescription = typeof description !== 'undefined' && description
      ? description
      : 'Boa Belts - ručno rađeni kožni kaiševi, torbe, novčanici i dodaci iz Travnika. Plaćanje pouzećem i dostava širom BiH.';
    const metaImage = typeof ogImage !== 'undefined' && ogImage
      ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
      : `${siteUrl}/images/og-image.jpg`;
    const canonicalUrl = `${siteUrl}${typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : currentPath}`;
  %>
  <meta name="description" content="<%= metaDescription %>">
  <% if (noindex) { %>
    <meta name="robots" content="noindex, nofollow">
  <% } else { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <meta name="theme-color" content="#ffffff">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
  <meta property="og:locale" content="bs_BA">
  <meta property="og:site_name" content="Boa Belts">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:image" content="<%= metaImage %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <meta name="twitter:image" content="<%= metaImage %>">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/images/logo/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/images/logo/favicon-48.png" sizes="48x48" type="image/png">
  <link rel="icon" href="/images/logo/favicon-96.png" sizes="96x96" type="image/png">
  <link rel="icon" href="/images/logo/favicon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/images/logo/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="stylesheet" href="/css/style.css?v=7">
  <% if (typeof jsonLdBlocks !== 'undefined') { jsonLdBlocks.forEach(function(block) { %>
    <script type="application/ld+json"><%- block %></script>
  <% }) } %>
  <% if (typeof preloadImage !== 'undefined' && preloadImage) { %>
    <link rel="preload" as="image" href="<%= preloadImage %>" fetchpriority="high">
  <% } %>
</head>
<body>
