<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="eyebrow">Nalog</div>
      <h1>Zdravo, <%= customer.name %></h1>
      <hr class="divider">
    </div>


    <div class="account-layout">
      <div class="account-profile">
        <div class="account-avatar"><%= customer.name.trim().charAt(0).toUpperCase() %></div>
        <h3>Vaši podaci</h3>

        <div class="account-info-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M3 6l9 7 9-7"/></svg>
          <span><%= customer.email %></span>
        </div>
        <% if (customer.phone) { %>
          <div class="account-info-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6.6 10.8c1.4 2.7 3.7 5 6.4 6.4l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
            <span><%= customer.phone %></span>
          </div>
        <% } %>
        <% if (customer.address) { %>
          <div class="account-info-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s7-7.4 7-12.5S16.3 2 12 2 5 4.9 5 9.5 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            <span><%= customer.address %><% if (customer.city) { %>, <%= customer.city %><% } %></span>
          </div>
        <% } %>

        <div class="account-actions">
          <a href="/nalog/izmjena" class="btn btn-outline btn-small" style="width:100%;">Izmijenite podatke</a>
          <form action="/nalog/odjava" method="POST">
            <button type="submit" class="btn btn-outline btn-small" style="width:100%;">Odjavite se</button>
          </form>
        </div>
      </div>

      <div class="account-orders">
        <h3>Vaše narudžbe</h3>
        <% if (orders.length === 0) { %>
          <p>Još nemate narudžbi. <a href="/kolekcija">Pogledajte kolekciju</a>.</p>
        <% } else { %>
          <% orders.forEach(function(order) { %>
            <div class="order-card">
              <div class="order-card-header">
                <div>
                  <strong>Narudžba #<%= order.id %></strong>
                  <span class="order-status"><%= statusLabels[order.status] || order.status %></span>
                </div>
                <span><%= formatDate(order.created_at) %></span>
              </div>
              <ul class="order-card-items">
                <% order.items.forEach(function(item) { %>
                  <li><%= item.name %> &times; <%= item.qty %> <% if (itemOptions(item).length) { %>(<%= itemOptions(item).join(', ') %>)<% } %></li>
                <% }) %>
              </ul>
              <% const track = trackingInfo(order); %>
              <% if (track) { %>
                <div class="order-card-tracking">
                  Pošiljka<% if (track.carrier) { %> (<%= track.carrier %>)<% } %>: <strong><%= track.number %></strong>
                  <% if (track.url) { %> &middot; <a href="<%= track.url %>" target="_blank" rel="noopener">Pratite pošiljku</a><% } %>
                </div>
              <% } %>
              <div class="order-card-total">Ukupno: <strong><%= order.total_km.toFixed(2) %> KM</strong></div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
