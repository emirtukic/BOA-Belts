<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section">
  <div class="container">

    <div class="contact-panel">
    <div class="contact-hero" id="upit">
      <div class="contact-hero-text">
        <h1>Kontakt</h1>
        <p>Imate pitanje o nekom modelu, narudžbi ili dostavi? Pišite nam ili nas pozovite, rado ćemo pomoći.</p>

        <div class="contact-methods">
          <div class="contact-method">
            <h4>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M3 6l9 7 9-7"/></svg>
              Pišite nam
            </h4>
            <p><a href="mailto:boabelts.webshop@gmail.com">boabelts.webshop@gmail.com</a></p>
          </div>
          <div class="contact-method">
            <h4>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6.6 10.8c1.4 2.7 3.7 5 6.4 6.4l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
              Pozovite nas
            </h4>
            <p><a href="tel:+387603265484">+387 60 32 65 484</a></p>
          </div>
          <div class="contact-method">
            <h4>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s7-7.4 7-12.5S16.3 2 12 2 5 4.9 5 9.5 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
              Gdje smo
            </h4>
            <p>Travnik, Bosna i Hercegovina</p>
          </div>
          <div class="contact-method">
            <h4>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12a8 8 0 1 1 8 8"/><path d="M4 12l4-4M4 12l4 4"/></svg>
              Pratite nas
            </h4>
            <div class="contact-social-icons">
              <a href="https://www.facebook.com/profile.php?id=100027303537151" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 8.5h2V5.2c-.35-.05-1.54-.15-2.94-.15-2.9 0-4.9 1.77-4.9 5.02v2.68H6.3v3.7h2.86V21h3.7v-8.55h2.75l.44-3.7h-3.19V10.5c0-1.07.29-1.8 1.94-1.8z"/></svg>
              </a>
              <a href="https://www.instagram.com/boa_belts/" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-panel">
        <h3>Pošaljite nam upit</h3>
        <form action="/kontakt" method="POST">
          <div class="form-honeypot" aria-hidden="true">
            <label>Web stranica <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
          </div>
          <div class="form-row">
            <input type="text" name="name" placeholder="Vaše ime i prezime*" aria-label="Ime i prezime" required>
          </div>
          <div class="form-row">
            <input type="email" name="email" placeholder="Vaš e-mail*" aria-label="E-mail" required>
          </div>
          <div class="form-row">
            <input type="tel" name="phone" placeholder="Broj telefona (opciono)" aria-label="Telefon">
          </div>
          <div class="form-row">
            <textarea name="message" rows="6" placeholder="Vaša poruka..." aria-label="Poruka" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Pošaljite upit</button>
        </form>
      </div>
    </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
